# ==============================================================================
# BLFA Learning Lab - Frontend Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development outside Docker,
# or to .env when running with Docker Compose.
# ==============================================================================

# Public GraphQL URL accessible from the developer's Web Browser.
# Next.js embeds NEXT_PUBLIC_* variables into the browser JavaScript bundle.
# Default localhost: http://localhost:9000/graphql
# Custom domain (if configured in hosts file): http://local.blfa.com:9000/graphql
NEXT_PUBLIC_WORDPRESS_API_URL=http://localhost:9000/graphql

# Internal Docker GraphQL URL for Server-Side Rendering (SSR) & Server Components.
# Inside Docker containers attached to 'blfa-network', Next.js reaches Nginx via service name 'nginx'.
# When running Next.js locally on your Windows host (npm run dev), set this to http://localhost:9000/graphql.
WORDPRESS_INTERNAL_API_URL=http://nginx/graphql

# Frontend Application Port
PORT=3000

# Node Environment
NODE_ENV=development
