# ==============================================================================
# BLFA Learning Lab - Backend Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env before starting the backend Docker Compose project:
# cp .env.example .env
# ==============================================================================

# Database Host (internal Docker network service name and port)
WORDPRESS_DB_HOST=db:3306

# Database Name
WORDPRESS_DB_NAME=blfa_local

# Database Application User
WORDPRESS_DB_USER=blfa_local

# Database Application Password (Local Dummy Credentials Only)
WORDPRESS_DB_PASSWORD=blfa_local_pass

# Database Root Password (Local Dummy Credentials Only)
WORDPRESS_DB_ROOT_PASSWORD=root_local_pass

# WordPress Table Prefix
WORDPRESS_TABLE_PREFIX=wp_

# WordPress Debug Mode (1 = enabled for local troubleshooting, 0 = disabled)
WORDPRESS_DEBUG=1

# External Nginx Host Port exposed to your workstation
WORDPRESS_PORT=9000

# Virtual Host Domain (localhost or local.blfa.com)
DOMAIN=localhost

# Reference Browser API URL for WPGraphQL
WORDPRESS_API_URL=http://localhost:9000/graphql

# Environment Indicator
DOCKER_ENV=local
